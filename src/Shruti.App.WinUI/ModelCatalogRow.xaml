<UserControl
    x:Class="Shruti.App.WinUI.ModelCatalogRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch">
    <Border x:Name="Separator" Padding="16,10" BorderBrush="{ThemeResource ShrutiBorderSubtleBrush}">
        <Grid x:Name="Layout" ColumnSpacing="16" SizeChanged="Layout_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="Description" VerticalAlignment="Center" Spacing="4">
                <TextBlock x:Name="ModelTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button x:Name="CompatibilityButton" Visibility="Collapsed" Content="Model details"
                            Style="{StaticResource SubtleButtonStyle}" Click="ShowProcessorDetails_Click" />
                    <TextBlock x:Name="Metadata" Grid.Column="1" FontSize="14" VerticalAlignment="Center"
                               Foreground="{ThemeResource ShrutiTextSecondaryBrush}" TextWrapping="Wrap" />
                </Grid>
                <HyperlinkButton x:Name="License" Content="Model license" Padding="0" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel x:Name="RowActions" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                <Border x:Name="InUse" Height="22" Padding="9,0" CornerRadius="11"
                        Background="{ThemeResource ShrutiAccentSoftBrush}" Visibility="Collapsed">
                    <TextBlock Text="In use" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{ThemeResource ShrutiAccentBrush}" />
                </Border>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
