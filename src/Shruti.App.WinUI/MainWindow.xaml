<Window
    x:Class="Shruti.App.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Shruti dictation">
    <Grid
        x:Name="Root"
        MinWidth="900"
        MinHeight="640"
        Background="{ThemeResource ShrutiPageBrush}">
        <Grid.Resources>
            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource ShrutiTextPrimaryBrush}" />
            </Style>
            <Style x:Key="MutedTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource ShrutiTextSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource ShrutiTextTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="MonoTextStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource ShrutiTextTertiaryBrush}" />
            </Style>
            <Style x:Key="NavButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="42" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource ShrutiTextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
            </Style>
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ShrutiCardBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ShrutiBorderSubtleBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Shadow">
                    <Setter.Value><ThemeShadow /></Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource ShrutiTextSecondaryBrush}" />
            </Style>
            <Style x:Key="ComputeButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource ShrutiTextSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style x:Key="QuietIconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource ShrutiTextSecondaryBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="10" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Grid.ColumnSpan="2"
            Padding="16,0,0,0"
            Background="{ThemeResource ShrutiCardBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="CaptionButtonInsetColumn" Width="140" />
            </Grid.ColumnDefinitions>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Background="{ThemeResource ShrutiAccentVividBrush}"
                    CornerRadius="4">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="1.1">
                        <Border Width="1.2" Height="3" Background="White" CornerRadius="1" />
                        <Border Width="1.2" Height="6" Background="White" CornerRadius="1" />
                        <Border Width="1.2" Height="9" Background="White" CornerRadius="1" />
                        <Border Width="1.2" Height="5" Background="White" CornerRadius="1" />
                        <Border Width="1.2" Height="2" Background="White" CornerRadius="1" />
                    </StackPanel>
                </Border>
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    LineHeight="16"
                    Text="Shruti" />
            </Grid>
        </Grid>

        <Border
            Grid.Row="1"
            Background="{ThemeResource ShrutiCardBrush}"
            BorderBrush="{ThemeResource ShrutiBorderSubtleBrush}"
            BorderThickness="0,0,1,0">
            <Grid Padding="12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Spacing="4">
                    <Button
                        x:Name="HomeNavButton"
                        AutomationProperties.Name="Dictation"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="Home"
                        Click="NavigationButton_Click">
                        <Grid Width="184">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE720;" />
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Text="Dictation" />
                            <Ellipse x:Name="ListeningNavDot" Grid.Column="2" Width="7" Height="7" Fill="{ThemeResource ShrutiAccentVividBrush}" Visibility="Collapsed" />
                        </Grid>
                    </Button>
                    <Button
                        x:Name="ModelsNavButton"
                        AutomationProperties.Name="Models"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="Models"
                        Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE81E;" />
                            <TextBlock VerticalAlignment="Center" Text="Models" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="SettingsNavButton"
                        AutomationProperties.Name="Settings"
                        Style="{StaticResource NavButtonStyle}"
                        Tag="Settings"
                        Click="NavigationButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <FontIcon FontFamily="Segoe Fluent Icons" FontSize="18" Glyph="&#xE9E9;" />
                            <TextBlock VerticalAlignment="Center" Text="Settings" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <Border
                    Grid.Row="2"
                    Padding="14"
                    Background="{ThemeResource ShrutiSunkenBrush}"
                    CornerRadius="10">
                    <StackPanel Spacing="6">
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Active model" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="ModelSummaryText" MaxWidth="120" FontWeight="SemiBold" Text="Whisper tiny.en" TextTrimming="CharacterEllipsis" />
                            <Border x:Name="ActiveComputeBadgeBorder" Padding="7,2" Background="{ThemeResource ShrutiCpuSoftBrush}" CornerRadius="10">
                                <TextBlock x:Name="ActiveComputeBadgeText" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource ShrutiCpuBrush}" Text="CPU" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="BackendSummaryText" Style="{StaticResource MonoTextStyle}" Text="on this PC" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Grid.Column="1" Background="{ThemeResource ShrutiPageBrush}">
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="48,36,48,48" Spacing="0">
                    <StackPanel Padding="0,24,0,36" HorizontalAlignment="Stretch" Spacing="18">
                        <Grid Width="112" Height="112">
                            <Ellipse
                                x:Name="MicPulseRing"
                                Width="96"
                                Height="96"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Opacity="0"
                                Stroke="{ThemeResource ShrutiAccentVividBrush}"
                                StrokeThickness="2">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform x:Name="MicPulseScale" CenterX="48" CenterY="48" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Button
                                x:Name="PrimaryDictationButton"
                                Width="96"
                                Height="96"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Start dictation"
                                Background="{ThemeResource ShrutiCardBrush}"
                                BorderBrush="{ThemeResource ShrutiBorderStrongBrush}"
                                BorderThickness="1"
                                CornerRadius="48"
                                Foreground="{ThemeResource ShrutiTextSecondaryBrush}"
                                Click="PrimaryDictationButton_Click">
                                <Grid>
                                    <FontIcon x:Name="PrimaryButtonIcon" FontFamily="Segoe Fluent Icons" FontSize="40" Glyph="&#xE720;" />
                                    <TextBlock x:Name="PrimaryButtonLabel" Text="Start dictation" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </Grid>

                        <StackPanel x:Name="AudioWaveformPanel" Height="28" HorizontalAlignment="Center" Orientation="Horizontal" Spacing="3" />
                        <ProgressBar x:Name="AudioLevelBar" Maximum="100" Minimum="0" Value="0" Visibility="Collapsed" />

                        <StackPanel HorizontalAlignment="Center" Spacing="5">
                            <TextBlock
                                x:Name="StatusText"
                                HorizontalAlignment="Center"
                                AutomationProperties.LiveSetting="Polite"
                                FontFamily="Segoe UI Variable Display, Segoe UI"
                                FontSize="20"
                                FontWeight="SemiBold"
                                Text="Press your shortcut to dictate anywhere" />
                            <TextBlock
                                x:Name="StatusSubText"
                                HorizontalAlignment="Center"
                                Style="{StaticResource MutedTextStyle}"
                                Text="Whisper tiny.en · on this PC" />
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="10">
                            <Border Height="30" Padding="12,0" Background="{ThemeResource ShrutiSunkenBrush}" BorderBrush="{ThemeResource ShrutiBorderSubtleBrush}" BorderThickness="1" CornerRadius="15">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE765;" />
                                    <TextBlock x:Name="HoldShortcutText" Style="{StaticResource MonoTextStyle}" Text="Ctrl+Win+Space" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="MicrophoneReadinessPill" Height="30" Padding="12,0" Background="Transparent" BorderBrush="{ThemeResource ShrutiBorderSubtleBrush}" BorderThickness="1" CornerRadius="15">
                                <TextBlock x:Name="MicrophoneReadinessText" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource ShrutiTextSecondaryBrush}" Text="Checking microphone" />
                            </Border>
                            <Button
                                x:Name="PauseButton"
                                Height="30"
                                Padding="12,0"
                                AutomationProperties.Name="Pause recording"
                                Background="Transparent"
                                BorderBrush="{ThemeResource ShrutiBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="15"
                                Click="PauseButton_Click">
                                <TextBlock x:Name="PauseButtonLabel" FontSize="12" FontWeight="SemiBold" Text="Pause" />
                            </Button>
                            <Button
                                x:Name="CancelButton"
                                Height="30"
                                Padding="12,0"
                                AutomationProperties.Name="Cancel dictation"
                                Background="Transparent"
                                BorderBrush="{ThemeResource ShrutiBorderSubtleBrush}"
                                BorderThickness="1"
                                CornerRadius="15"
                                Click="CancelButton_Click">
                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="Cancel" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="StateText" Text="Idle" Visibility="Collapsed" />
                        <TextBlock x:Name="TargetText" Text="No target captured" Visibility="Collapsed" />
                        <TextBlock x:Name="StatusPillText" Text="Ready" Visibility="Collapsed" />
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Recent" />
                        <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextStyle}" Text="Copied straight to where you were typing" />
                    </Grid>

                    <Border x:Name="CurrentTranscriptCard" Padding="18,16" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                        <StackPanel Spacing="10">
                            <TextBox
                                x:Name="TranscriptPreviewBox"
                                MinHeight="72"
                                AcceptsReturn="True"
                                AutomationProperties.Name="Transcript preview"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Segoe UI Variable Text, Segoe UI"
                                FontSize="16"
                                Foreground="{ThemeResource ShrutiTextPrimaryBrush}"
                                IsReadOnly="True"
                                PlaceholderText="Your latest transcript will appear here."
                                TextWrapping="Wrap" />
                            <TextBlock x:Name="UserMessageText" AutomationProperties.LiveSetting="Polite" Style="{StaticResource MonoTextStyle}" Text="Dictation is ready." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <CheckBox x:Name="ReplaceSelectionCheckBox" Content="Replace selected text" Visibility="Collapsed" />
                                <Button x:Name="CopyButton" AutomationProperties.Name="Copy transcript" Click="CopyButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE8C8;" />
                                        <TextBlock Text="Copy" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="InsertPreviewButton" AutomationProperties.Name="Insert preview transcript" Click="InsertPreviewButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE8A7;" />
                                        <TextBlock Text="Insert" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="RetryButton" AutomationProperties.Name="Retry dictation" Click="RetryButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE72C;" />
                                        <TextBlock Text="Retry" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock x:Name="ErrorText" AutomationProperties.LiveSetting="Assertive" Foreground="{ThemeResource ShrutiDangerBrush}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="EmptyRecentCard" Padding="0,38" Background="Transparent" CornerRadius="16">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <FontIcon HorizontalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="{ThemeResource ShrutiTextTertiaryBrush}" Glyph="&#xE720;" />
                            <TextBlock Style="{StaticResource MutedTextStyle}" Text="Your transcriptions will show up here." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ModelsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="48,36,48,48" Spacing="0">
                    <StackPanel Margin="0,0,0,22" Spacing="4">
                        <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" Text="Models" />
                        <TextBlock Style="{StaticResource MutedTextStyle}" Text="Everything runs on this PC — pick a model, pick where it runs." />
                    </StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{ThemeResource ShrutiTextSecondaryBrush}" Text="Run models on" />
                            <Border Padding="4" Background="{ThemeResource ShrutiSunkenBrush}" CornerRadius="10">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button x:Name="BackendAutoButton" Style="{StaticResource ComputeButtonStyle}" Tag="Auto" Visibility="Collapsed" Click="BackendButton_Click">Auto</Button>
                                    <Button x:Name="BackendNpuButton" Style="{StaticResource ComputeButtonStyle}" Tag="Npu" Click="BackendButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE735;" /><TextBlock Text="NPU" /></StackPanel>
                                    </Button>
                                    <Button x:Name="BackendGpuButton" Style="{StaticResource ComputeButtonStyle}" Tag="Gpu" Click="BackendButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE945;" /><TextBlock Text="GPU" /></StackPanel>
                                    </Button>
                                    <Button x:Name="BackendCpuButton" Style="{StaticResource ComputeButtonStyle}" Tag="Cpu" Click="BackendButton_Click">
                                        <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE950;" /><TextBlock Text="CPU" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="ModelsStatusText" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MonoTextStyle}" Text="Checking installed models" />
                    </Grid>
                    <ProgressBar x:Name="ModelDownloadProgressBar" Height="4" IsIndeterminate="False" Maximum="100" Minimum="0" Visibility="Collapsed" />
                    <TextBlock x:Name="ModelsDirectoryText" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                    <StackPanel x:Name="ModelListPanel" Spacing="12" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel Width="815" Padding="48,36,48,48" HorizontalAlignment="Left" Spacing="0">
                    <TextBlock FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="28" FontWeight="SemiBold" Text="Settings" />

                    <TextBlock Margin="0,24,0,10" Style="{StaticResource SectionLabelStyle}" Text="Dictation" />
                    <Border Padding="24,4" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Padding="0,15" ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" Background="{ThemeResource ShrutiPageBrush}" CornerRadius="10">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource ShrutiTextSecondaryBrush}" Glyph="&#xE92E;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Dictation hotkey" /><TextBlock Style="{StaticResource CaptionTextStyle}" Text="Hold this anywhere in Windows while you speak." /></StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                                    <TextBox x:Name="PushToTalkKeyTextBox" Width="140" Height="32" Text="Ctrl+Win+Space" LostFocus="TriggerConfigurationInput_LostFocus" />
                                    <Button Height="32" Padding="8,0" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource ShrutiAccentBrush}" Content="Change" Click="ChangeHotkeyButton_Click" />
                                </StackPanel>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource ShrutiBorderSubtleBrush}" />
                            <Grid Padding="0,15" ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" Background="{ThemeResource ShrutiPageBrush}" CornerRadius="10">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource ShrutiTextSecondaryBrush}" Glyph="&#xE8B0;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Insertion mode" /><TextBlock Style="{StaticResource CaptionTextStyle}" Text="Choose what happens after transcription." /></StackPanel>
                                <ComboBox x:Name="InsertionModeComboBox" Grid.Column="2" Width="220" Height="32" HorizontalAlignment="Right" SelectionChanged="InsertionModeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Auto-insert" Tag="AutoInsert" /><ComboBoxItem Content="Preview first" Tag="PreviewFirst" /><ComboBoxItem Content="Copy only" Tag="CopyOnly" />
                                </ComboBox>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource ShrutiBorderSubtleBrush}" />
                            <Grid Padding="0,15" ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" Background="{ThemeResource ShrutiPageBrush}" CornerRadius="10">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource ShrutiTextSecondaryBrush}" Glyph="&#xE720;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Microphone" /><TextBlock Style="{StaticResource CaptionTextStyle}" Text="The device Shruti uses for local dictation." /></StackPanel>
                                <ComboBox x:Name="AudioDeviceComboBox" Grid.Column="2" Width="220" Height="32" HorizontalAlignment="Right" IsEnabled="False" PlaceholderText="Loading microphones" SelectionChanged="AudioDeviceComboBox_SelectionChanged" />
                            </Grid>
                            <Border Height="1" Background="{ThemeResource ShrutiBorderSubtleBrush}" />
                            <Grid Padding="0,15" ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="260" /></Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" Background="{ThemeResource ShrutiPageBrush}" CornerRadius="10">
                                    <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="{ThemeResource ShrutiTextSecondaryBrush}" Glyph="&#xE74D;" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Audio retention" /><TextBlock Style="{StaticResource CaptionTextStyle}" Text="Control whether temporary recordings stay on disk." /></StackPanel>
                                <ComboBox x:Name="AudioRetentionComboBox" Grid.Column="2" Width="220" Height="32" HorizontalAlignment="Right" SelectionChanged="AudioRetentionComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Delete after transcription" Tag="DeleteAfterTranscription" /><ComboBoxItem Content="Keep recordings" Tag="Keep" /><ComboBoxItem Content="Ask each time" Tag="AskEveryTime" />
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,24,0,10" Style="{StaticResource SectionLabelStyle}" Text="Models &amp; compute" />
                    <Border Padding="24,4" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Padding="0,16" ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Run models on" /><TextBlock Style="{StaticResource CaptionTextStyle}" Text="Choose the processor used for local transcription." /></StackPanel>
                                <Border Grid.Column="1" Padding="4" Background="{ThemeResource ShrutiSunkenBrush}" CornerRadius="10">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button x:Name="SettingsBackendNpuButton" Tag="Npu" Style="{StaticResource ComputeButtonStyle}" Click="BackendButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE735;" /><TextBlock Text="NPU" /></StackPanel>
                                        </Button>
                                        <Button x:Name="SettingsBackendGpuButton" Tag="Gpu" Style="{StaticResource ComputeButtonStyle}" Click="BackendButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE945;" /><TextBlock Text="GPU" /></StackPanel>
                                        </Button>
                                        <Button x:Name="SettingsBackendCpuButton" Tag="Cpu" Style="{StaticResource ComputeButtonStyle}" Click="BackendButton_Click">
                                            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon FontFamily="Segoe Fluent Icons" FontSize="14" Glyph="&#xE950;" /><TextBlock Text="CPU" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource ShrutiBorderSubtleBrush}" />
                            <Grid Padding="0,16" ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock x:Name="SettingsActiveModelNameText" FontWeight="SemiBold" Text="Active model" /><TextBlock x:Name="SelectedModelStatusText" Style="{StaticResource CaptionTextStyle}" Text="Checking model" /></StackPanel>
                                <Button Grid.Column="1" Height="32" Padding="12,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource ShrutiAccentBrush}" Content="Manage" Tag="Models" Click="NavigationButton_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Grid Visibility="Collapsed">
                        <ComboBox x:Name="ModelSelectionComboBox" SelectionChanged="ModelSelectionComboBox_SelectionChanged" />
                        <ComboBox x:Name="BackendPreferenceComboBox" SelectionChanged="BackendPreferenceComboBox_SelectionChanged">
                            <ComboBoxItem Content="Auto" Tag="Auto" /><ComboBoxItem Content="NPU" Tag="Npu" /><ComboBoxItem Content="GPU" Tag="Gpu" /><ComboBoxItem Content="CPU" Tag="Cpu" />
                        </ComboBox>
                        <TextBlock x:Name="ActiveBackendText" Text="Checking readiness" />
                        <TextBlock x:Name="BackendReadinessText" AutomationProperties.LiveSetting="Polite" Text="Backend readiness has not been checked yet." />
                    </Grid>

                    <TextBlock Margin="0,24,0,10" Style="{StaticResource SectionLabelStyle}" Text="Startup &amp; appearance" />
                    <Border Padding="24,4" Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <Grid Padding="0,16" ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="280" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="3"><TextBlock FontWeight="SemiBold" Text="Theme" /><TextBlock Style="{StaticResource CaptionTextStyle}" Text="Use the Windows setting, light, or dark." /></StackPanel>
                                <ComboBox x:Name="ThemeComboBox" Grid.Column="1" Height="32" SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="Use Windows setting" Tag="Default" /><ComboBoxItem Content="Light" Tag="Light" /><ComboBoxItem Content="Dark" Tag="Dark" />
                                </ComboBox>
                            </Grid>
                            <Border Height="1" Background="{ThemeResource ShrutiBorderSubtleBrush}" />
                            <StackPanel Padding="0,16" Spacing="10">
                                <ToggleSwitch x:Name="PushToTalkCheckBox" Header="Hold-to-dictate shortcut" IsOn="True" Toggled="TriggerConfigurationToggle_Toggled" />
                                <ToggleSwitch x:Name="TrayMenuCheckBox" Header="Tray menu commands" IsOn="True" Toggled="TriggerConfigurationToggle_Toggled" />
                                <ToggleSwitch x:Name="GlobalHotkeyCheckBox" Header="Single-press global trigger" IsOn="False" Toggled="TriggerConfigurationToggle_Toggled" />
                                <TextBox x:Name="HotkeyGestureTextBox" Header="Single-press shortcut" Text="Ctrl+Win+Space" LostFocus="TriggerConfigurationInput_LostFocus" />
                                <CheckBox x:Name="AllowSlowTranscriptionCheckBox" Content="Allow slower-than-real-time transcription" Click="AllowSlowTranscriptionCheckBox_Click" />
                                <TextBlock x:Name="TriggerStatusText" Style="{StaticResource CaptionTextStyle}" Text="Triggers are active." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Margin="0,14,0,0" Padding="20,18" Background="{ThemeResource ShrutiSuccessSoftBrush}" CornerRadius="16">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Width="36" Height="36" Background="{ThemeResource ShrutiCardBrush}" CornerRadius="10">
                                <FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="18" Foreground="{ThemeResource ShrutiSuccessBrush}" Glyph="&#xE72E;" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3"><TextBlock FontWeight="SemiBold" Text="Everything stays on this PC" /><TextBlock Style="{StaticResource MutedTextStyle}" FontSize="12" Text="Shruti never sends your audio or text off your device. There is no account and no cloud." /></StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Margin="0,12,0,0" Style="{StaticResource SectionLabelStyle}" Text="Diagnostics" />
                    <Border Padding="20" Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <TextBlock FontWeight="SemiBold" Text="Latest redacted snapshot" />
                            <TextBlock x:Name="DiagnosticsSnapshotText" Style="{StaticResource MonoTextStyle}" Text="Run dictation to populate a redacted diagnostics snapshot." TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="{ThemeResource ShrutiAccentBrush}" Click="ReplayWelcomeButton_Click">Replay welcome</Button>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource MonoTextStyle}" Text="Shruti 1.0 · open source" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid
            x:Name="OnboardingLayer"
            Grid.Row="0"
            Grid.RowSpan="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Canvas.ZIndex="100"
            Background="#73000000"
            Visibility="Collapsed">
            <Border
                Width="468"
                MaxWidth="468"
                Padding="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource ShrutiOverlayBrush}"
                BorderBrush="{ThemeResource ShrutiBorderSubtleBrush}"
                BorderThickness="1"
                CornerRadius="16">
                <StackPanel Spacing="18">
                    <StackPanel x:Name="OnboardingWelcomeStep" HorizontalAlignment="Center" Spacing="18">
                        <Border Width="56" Height="56" HorizontalAlignment="Center" Background="{ThemeResource ShrutiAccentVividBrush}" CornerRadius="14">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="3">
                                <Border Width="3" Height="10" Background="White" CornerRadius="2" /><Border Width="3" Height="20" Background="White" CornerRadius="2" /><Border Width="3" Height="30" Background="White" CornerRadius="2" /><Border Width="3" Height="17" Background="White" CornerRadius="2" /><Border Width="3" Height="7" Background="White" CornerRadius="2" />
                            </StackPanel>
                        </Border>
                        <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="40" FontWeight="Bold" Text="Speak freely" />
                        <TextBlock MaxWidth="350" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedTextStyle}" FontSize="16" Text="Shruti turns your voice into text anywhere in Windows — and every word is processed right here on your PC." />
                        <Button Height="48" Padding="24,0" HorizontalAlignment="Center" Background="{ThemeResource ShrutiAccentBrush}" Foreground="{ThemeResource ShrutiAccentForegroundBrush}" CornerRadius="10" Click="OnboardingNextButton_Click">Get started</Button>
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource MonoTextStyle}" Text="Nothing you say leaves this PC" />
                    </StackPanel>

                    <StackPanel x:Name="OnboardingMicrophoneStep" HorizontalAlignment="Center" Spacing="18" Visibility="Collapsed">
                        <Border Width="64" Height="64" HorizontalAlignment="Center" Background="{ThemeResource ShrutiAccentSoftBrush}" CornerRadius="32"><FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="{ThemeResource ShrutiAccentBrush}" Glyph="&#xE720;" /></Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Let Shruti hear you" />
                        <TextBlock MaxWidth="350" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="Shruti needs your microphone to dictate. Audio is transcribed on the spot and never saved unless you choose to keep it." />
                        <TextBlock x:Name="OnboardingMicStatusText" HorizontalAlignment="Center" Style="{StaticResource CaptionTextStyle}" Text="We will check your Windows microphone access." />
                        <Button Height="48" Padding="24,0" HorizontalAlignment="Center" Background="{ThemeResource ShrutiAccentBrush}" Foreground="{ThemeResource ShrutiAccentForegroundBrush}" CornerRadius="10" Click="OnboardingMicrophoneButton_Click">Check microphone</Button>
                    </StackPanel>

                    <StackPanel x:Name="OnboardingModelStep" Spacing="18" Visibility="Collapsed">
                        <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Get your first model" />
                        <TextBlock MaxWidth="350" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="Start with Shruti's recommended English model. You can add or change models later." />
                        <Border Padding="18,16" Style="{StaticResource CardBorderStyle}">
                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel Spacing="4"><TextBlock x:Name="OnboardingModelNameText" FontSize="16" FontWeight="SemiBold" Text="Whisper tiny.en" /><TextBlock x:Name="OnboardingModelMetaText" Style="{StaticResource MonoTextStyle}" Text="English · on this PC" /></StackPanel>
                                <Button x:Name="OnboardingModelActionButton" Grid.Column="1" VerticalAlignment="Center" Height="34" Padding="14,0" Background="{ThemeResource ShrutiAccentBrush}" Foreground="{ThemeResource ShrutiAccentForegroundBrush}" CornerRadius="10" Click="OnboardingModelActionButton_Click">Download</Button>
                            </Grid>
                        </Border>
                        <ProgressBar x:Name="OnboardingModelProgressBar" Height="4" Maximum="100" Minimum="0" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel x:Name="OnboardingHotkeyStep" HorizontalAlignment="Center" Spacing="18" Visibility="Collapsed">
                        <Border Width="64" Height="64" HorizontalAlignment="Center" Background="{ThemeResource ShrutiAccentSoftBrush}" CornerRadius="32"><FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="{ThemeResource ShrutiAccentBrush}" Glyph="&#xE765;" /></Border>
                        <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="SemiBold" Text="Your dictation hotkey" />
                        <TextBlock x:Name="OnboardingHotkeyText" Padding="24,10" HorizontalAlignment="Center" FontFamily="Cascadia Code, Consolas" FontSize="28" FontWeight="SemiBold" Foreground="{ThemeResource ShrutiAccentBrush}" Text="Ctrl+Win+Space" />
                        <TextBlock MaxWidth="350" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedTextStyle}" Text="Hold it anywhere in Windows while you speak. You can change it later in settings." />
                        <Button Height="48" Padding="24,0" HorizontalAlignment="Center" Background="{ThemeResource ShrutiAccentBrush}" Foreground="{ThemeResource ShrutiAccentForegroundBrush}" CornerRadius="10" Click="OnboardingNextButton_Click">Continue</Button>
                    </StackPanel>

                    <StackPanel x:Name="OnboardingDoneStep" HorizontalAlignment="Center" Spacing="18" Visibility="Collapsed">
                        <Border Width="64" Height="64" HorizontalAlignment="Center" Background="{ThemeResource ShrutiSuccessSoftBrush}" CornerRadius="32"><FontIcon HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe Fluent Icons" FontSize="32" Foreground="{ThemeResource ShrutiSuccessBrush}" Glyph="&#xE73E;" /></Border>
                        <TextBlock HorizontalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="40" FontWeight="Bold" Text="You're all set" />
                        <TextBlock x:Name="OnboardingDoneText" MaxWidth="350" HorizontalAlignment="Center" TextAlignment="Center" Style="{StaticResource MutedTextStyle}" FontSize="16" Text="Your local model is ready. Hold your shortcut to dictate anywhere." />
                        <Button Height="48" Padding="24,0" HorizontalAlignment="Center" Background="{ThemeResource ShrutiAccentBrush}" Foreground="{ThemeResource ShrutiAccentForegroundBrush}" CornerRadius="10" Click="OnboardingFinishButton_Click">Start using Shruti</Button>
                    </StackPanel>

                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="6">
                        <Border x:Name="OnboardingDot0" Width="20" Height="8" Background="{ThemeResource ShrutiAccentBrush}" CornerRadius="4" />
                        <Border x:Name="OnboardingDot1" Width="8" Height="8" Background="{ThemeResource ShrutiBorderStrongBrush}" CornerRadius="4" />
                        <Border x:Name="OnboardingDot2" Width="8" Height="8" Background="{ThemeResource ShrutiBorderStrongBrush}" CornerRadius="4" />
                        <Border x:Name="OnboardingDot3" Width="8" Height="8" Background="{ThemeResource ShrutiBorderStrongBrush}" CornerRadius="4" />
                        <Border x:Name="OnboardingDot4" Width="8" Height="8" Background="{ThemeResource ShrutiBorderStrongBrush}" CornerRadius="4" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
