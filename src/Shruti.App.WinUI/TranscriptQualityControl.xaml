<UserControl x:Class="Shruti.App.WinUI.TranscriptQualityControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="10">
        <TextBlock Text="Dictation cleanup" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="Light cleanup works without a download." Foreground="{ThemeResource ShrutiTextSecondaryBrush}" TextWrapping="Wrap" />
        <Border Background="{ThemeResource ShrutiCardBrush}" BorderBrush="{ThemeResource ShrutiBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="18,10,18,14">
            <StackPanel Spacing="4">
                <CheckBox x:Name="CleanupBox" Content="Light cleanup and spoken formatting" Click="Preferences_Click" />
                <CheckBox x:Name="ContextBox" Content="Use nearby text for spacing and vocabulary" Click="Preferences_Click" />
                <TextBlock Margin="0,4,0,0" Text="You can restore the original text of your latest dictation." FontSize="13" Foreground="{ThemeResource ShrutiTextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TextBlock Margin="0,12,0,0" Text="Optional cleanup model" FontSize="16" FontWeight="SemiBold" />
        <TextBlock Text="Use Qwen to revise dictated sentences on this PC." Foreground="{ThemeResource ShrutiTextSecondaryBrush}" TextWrapping="Wrap" />
        <Border x:Name="ModelCard" Background="{ThemeResource ShrutiCardBrush}" BorderBrush="{ThemeResource ShrutiBorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
            <StackPanel>
                <Grid Padding="18,14" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Qwen3.5-2B" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="1.3 GB · English · CPU · Q4_K_M" FontSize="13" Foreground="{ThemeResource ShrutiTextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="ModelStatusText" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{ThemeResource ShrutiAccentBrush}" />
                        <Button x:Name="InstallButton" Content="Download" Click="Install_Click" AutomationProperties.Name="Download Qwen3.5-2B" />
                        <Button x:Name="ToggleModelButton" Content="Set active" Click="ToggleModel_Click" AutomationProperties.Name="Use Qwen3.5-2B for dictation cleanup" />
                    </StackPanel>
                </Grid>
                <ProgressBar x:Name="DownloadProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" />
            </StackPanel>
        </Border>
        <TextBlock x:Name="MessageText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
