<UserControl x:Class="Shruti.App.WinUI.TranscriptQualityControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#BC5610" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#98430B" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="CheckBoxCheckBackgroundFillChecked" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="CheckBoxCheckBackgroundFillCheckedPointerOver" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="CheckBoxCheckBackgroundFillCheckedPointerOver" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="CheckBoxCheckBackgroundFillCheckedPointerOver" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillChecked" Color="#EA8D46" />
                    <SolidColorBrush x:Key="CheckBoxCheckBackgroundFillCheckedPointerOver" Color="#F2B078" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeChecked" ResourceKey="CheckBoxCheckBackgroundFillChecked" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPointerOver" ResourceKey="CheckBoxCheckBackgroundFillCheckedPointerOver" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundFillCheckedPressed" ResourceKey="CheckBoxCheckBackgroundFillCheckedPointerOver" />
                    <StaticResource x:Key="CheckBoxCheckBackgroundStrokeCheckedPressed" ResourceKey="CheckBoxCheckBackgroundFillCheckedPointerOver" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast" />
            </ResourceDictionary.ThemeDictionaries>
            <DataTemplate x:Key="CleanupBenchmark">
                <StackPanel Spacing="12">
                    <TextBlock Text="An exact match means the output matched the expected transcript. Of 3,000 synthetic English inputs, 35 already matched before cleanup." TextWrapping="Wrap" Foreground="{ThemeResource ShrutiTextSecondaryBrush}" />
                    <Grid RowSpacing="10" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Model" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="1" Text="Exact matches" TextWrapping="Wrap" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Column="2" Text="Kept unchanged" TextWrapping="Wrap" TextAlignment="Right" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                        <TextBlock Grid.Row="1" Text="Qwen3.5-2B" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="76 / 3,000" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="33 / 35" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="2" Text="Utter Mini 1B" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="241 / 3,000" HorizontalAlignment="Right" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="27 / 35" HorizontalAlignment="Right" />
                    </Grid>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Spacing="10">
        <TextBlock Text="Dictation cleanup" FontSize="19" FontWeight="SemiBold" />
        <TextBlock Text="Light cleanup applies punctuation and spoken formatting on this PC." Foreground="{ThemeResource ShrutiTextSecondaryBrush}" TextWrapping="Wrap" />
        <Border Background="{ThemeResource ShrutiCardBrush}" BorderBrush="{ThemeResource ShrutiBorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="18,10,18,14">
            <StackPanel Spacing="4">
                <CheckBox x:Name="CleanupBox" Content="Light cleanup and spoken formatting" Click="Preferences_Click" />
                <CheckBox x:Name="ContextBox" Content="Use nearby text for spacing and vocabulary" Click="Preferences_Click" />
                <TextBlock Margin="0,4,0,0" Text="You can restore the original text of your latest dictation." FontSize="13" Foreground="{ThemeResource ShrutiTextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <TextBlock Margin="0,12,0,0" Text="Optional cleanup models" FontSize="16" FontWeight="SemiBold" />
        <TextBlock x:Name="ModelGuidance" Text="An optional model adds an editing pass after transcription." Foreground="{ThemeResource ShrutiTextSecondaryBrush}" TextWrapping="Wrap" />
        <Border Background="{ThemeResource ShrutiCardBrush}" BorderBrush="{ThemeResource ShrutiBorderSubtleBrush}" BorderThickness="1" CornerRadius="12">
            <StackPanel x:Name="Models" />
        </Border>
        <HyperlinkButton x:Name="BenchmarkDetails" Content="Compare cleanup models" Click="CompareModels_Click" Padding="0" />
        <TextBlock Text="Compare the edits with your original in Transcriptions." FontSize="13" Foreground="{ThemeResource ShrutiTextSecondaryBrush}" TextWrapping="Wrap" />
        <ProgressBar x:Name="DownloadProgress" Height="4" IsIndeterminate="True" Visibility="Collapsed" />
        <TextBlock x:Name="MessageText" AutomationProperties.LiveSetting="Polite" TextWrapping="Wrap" />
    </StackPanel>
</UserControl>
