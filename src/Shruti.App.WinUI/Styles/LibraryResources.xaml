<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="LibraryPrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource ShrutiAccentBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource ShrutiAccentForegroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style x:Key="LibraryAccentTile" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ShrutiAccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="LibraryAccentIcon" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource ShrutiAccentBrush}" />
    </Style>
    <Style x:Key="LibrarySeparator" TargetType="Border">
        <Setter Property="BorderBrush" Value="{ThemeResource ShrutiBorderSubtleBrush}" />
    </Style>
    <Style x:Key="LibraryMutedText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{ThemeResource ShrutiTextSecondaryBrush}" />
    </Style>
    <Style x:Key="LibraryChartTrack" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ShrutiSunkenBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource ShrutiBorderSubtleBrush}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
    <Style x:Key="LibraryChartInk" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ShrutiAccentVividBrush}" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>
</ResourceDictionary>
